{
  "name": "apeciied",
  "private": true,
  "scripts": {
    "check:versions": "node scripts/check-versions.mjs",
    "test": "node --test scripts/*.test.mjs",
    "build:css": "tailwindcss -i src/style.css -o assets/css/style.css --minify",
    "build:jekyll": "bundle exec jekyll build",
    "build": "run-s check:versions test build:css build:jekyll",
    "dev:css": "tailwindcss -i src/style.css -o assets/css/style.css --watch",
    "dev:jekyll": "bundle exec jekyll serve --livereload --incremental --port 4000",
    "dev": "run-s check:versions build:css && run-p dev:css dev:jekyll",
    "start": "npm run dev"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "npm-run-all2": "^9.1.0",
    "tailwindcss": "^4.3.5"
  }
}
